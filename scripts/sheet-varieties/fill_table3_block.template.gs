/**
 * @@TITLE@@
 *
 * GENERATED by build_table3_block.py from @@DRAFTS@@. Edit the texts there and rebuild, not here.
 * Needs scripts/sheet-common/sheet_config.gs in the same Apps Script project (SheetConfig: the tab name,
 * header, columns and the run switches). The review file @@REVIEW@@ is written to WIKICROP_SOURCE_BOOKS.
 *
 * What a run does, in groups 7-13 of `Thông tin giống & Canh tác`, rows found by the variety
 * name in B:
 *   - writes the drafted C and D cells (fill: the cell must be empty, replace: it must still hold the
 *     misplaced text, append: it must be unchanged since the build, and the text goes after it as a new
 *     paragraph),
 *   - for each merge: writes one shared D for the species into the top cell, clears the rest and merges
 *     the range (top aligned),
 *   - writes E (Nguồn phụ) with the sources of what was written, on every row touched (rows that already
 *     had sources keep them, with the new ones added after),
 *   - appends the reason to G (Lý do sửa). F (Người sửa) is written only if SheetConfig.EDITOR is set.
 *
 * Safety: before writing, it checks that every variety is found exactly once in groups 7-13, every cell is in
 * the expected state, every E is empty (or unchanged since the build where sources are appended), and
 * every merge block is one species with the expected D cells
 * filled and nothing merged yet, and no cell it writes sits inside a merged range below its top cell (Sheets
 * would drop the value). If anything differs it stops and lists the differences, with nothing
 * written. A second run stops at the check, because the cells are no longer empty.
 *
 * Use:
 *   1. In the sheet: Extensions → Apps Script. Add a script file, paste all of this file, save. Paste
 *      sheet_config.gs too if the project does not have it yet.
 *   2. Run `@@FN@@` with SheetConfig.DRY_RUN = true. Read the execution log.
 *   3. Set SheetConfig.DRY_RUN = false and run again.
 *   File → Version history keeps the state before the run if it needs undoing.
 */
function @@FN@@() {
  // Run settings: set them here, then run.
  SheetConfig.DRY_RUN = true;         // true = only log the changes
  SheetConfig.EDITOR = '';            // name for F (Người sửa) on changed rows, '' leaves F alone
  SheetConfig.WRITE_REASONS = true;   // append the reason to G (Lý do sửa)

  const T = SheetConfig.VARIETY_INFO, EDITOR = SheetConfig.EDITOR;
  const COL = { A: T.COL.SPECIES, B: T.COL.VARIETY, C: T.COL.INFO, D: T.COL.CULTIVATION,
                E: T.COL.SOURCE, F: T.COL.EDITOR, G: T.COL.REASON };
  const W = T.COL.REASON;
  // cells: {B, col, mode: fill|replace|append, was, text}. merges: {species, first, last, filled, text}.
  // e: B -> E text. e_was: B -> E as it was at the build, for rows whose sources are appended.
  // reasons: B -> [G lines]. counts: what the build expects.
  const DATA = /*DATA*/{};

  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName(T.SHEET_NAME);
  if (!sheet) throw new Error(`No sheet named "${T.SHEET_NAME}".`);
  const last = sheet.getLastRow();
  const values = sheet.getRange(1, 1, last, W).getValues();
  const raw = (row, col) => String(values[row - 1][col - 1]);
  const text = (row, col) => raw(row, col).normalize('NFC').trim();

  // 1. Find the rows of groups 7-13: below the header band, above the label row.
  const problems = [];
  const find = (from, to, test) => { const rs = []; for (let r = from; r <= to; r++) if (test(r)) rs.push(r); return rs; };
  const one = (rs, what) => {
    if (rs.length !== 1) { problems.push(`Expected one ${what}, found ${rs.length ? 'rows ' + rs.join(', ') : 'none'}.`); return 0; }
    return rs[0];
  };
  const head = one(find(1, last, r => text(r, COL.A) === T.HEADER[0] && text(r, COL.B) === T.HEADER[1]), `"${T.HEADER.join(' | ')}" row`);
  const stop = one(find(head + 1, last, r => text(r, COL.A).startsWith(T.SCOPE_END_LABEL)), `"${T.SCOPE_END_LABEL}" label row`);
  if (problems.length) throw new Error(`Nothing written:\n${problems.join('\n')}`);

  // 2. Find every variety and check the cells.
  const rowOf = {};
  const names = new Set(DATA.cells.map(c => c.B).concat(Object.keys(DATA.e), Object.keys(DATA.reasons),
                                                        ...DATA.merges.map(m => [m.first, m.last])));
  names.forEach(b => { rowOf[b] = one(find(head + 1, stop - 1, r => text(r, COL.B) === b), `row "${b}"`); });
  if (problems.length) throw new Error(`Nothing written:\n${problems.join('\n')}`);
  DATA.cells.forEach(c => {
    const r = rowOf[c.B], cur = raw(r, COL[c.col]);
    if (c.mode === 'fill' && cur.trim()) problems.push(`${c.B} ${c.col}${r} is no longer empty.`);
    if (c.mode === 'replace' && cur.indexOf(c.was) < 0) problems.push(`${c.B} ${c.col}${r} no longer holds "${c.was}".`);
    if (c.mode === 'append' && cur.normalize('NFC').trim() !== c.was.normalize('NFC').trim()) problems.push(`${c.B} ${c.col}${r} has changed since the build.`);
  });
  const eWas = DATA.e_was || {};
  Object.keys(DATA.e).forEach(b => {
    const cur = text(rowOf[b], COL.E);
    if (b in eWas) { if (cur !== eWas[b].normalize('NFC')) problems.push(`${b} E${rowOf[b]} has changed since the build.`); }
    else if (cur) problems.push(`${b} E${rowOf[b]} is not empty.`);
  });

  // Each merge block: one species, the known D cells filled, nothing merged in D.
  const blocks = DATA.merges.map(m => {
    const top = rowOf[m.first], bot = rowOf[m.last];
    if (bot <= top) problems.push(`"${m.last}" (row ${bot}) is not below "${m.first}" (row ${top}).`);
    if (!text(top, COL.A).startsWith(m.species)) problems.push(`"${m.first}" (row ${top}) does not start the ${m.species} block.`);
    if (bot + 1 < stop && text(bot + 1, COL.B) && !text(bot + 1, COL.A)) problems.push(`"${m.last}" (row ${bot}) is not the last row of ${m.species}.`);
    for (let r = top + 1; r <= bot; r++) if (text(r, COL.A)) problems.push(`Row ${r} starts another species: "${text(r, COL.A)}".`);
    const filled = find(top, bot, r => text(r, COL.D) !== '').map(r => text(r, COL.B));
    if (filled.join('|') !== m.filled.join('|')) problems.push(`${m.species} D: filled rows are ${filled.join(', ') || 'none'}, expected ${m.filled.join(', ') || 'none'}.`);
    if (sheet.getRange(top, COL.D, bot - top + 1, 1).getMergedRanges().length) problems.push(`${m.species} D${top}:D${bot} already has merged cells.`);
    return { m, top, bot };
  });

  // Sheets drops a value written inside a merged range below its top cell, so stop rather than lose it.
  const merged = sheet.getRange(head + 1, 1, stop - head - 1, W).getMergedRanges();
  const hiddenBy = (r, c) => merged.find(m => r >= m.getRow() && r < m.getRow() + m.getNumRows() && c >= m.getColumn() &&
                                            c < m.getColumn() + m.getNumColumns() && (r !== m.getRow() || c !== m.getColumn()));
  DATA.cells.map(c => [c.B, c.col])
    .concat(Object.keys(DATA.e).map(b => [b, 'E']), Object.keys(DATA.reasons).map(b => [b, 'G']))
    .forEach(([b, col]) => {
      const m = hiddenBy(rowOf[b], COL[col]);
      if (m) problems.push(`${b} ${col}${rowOf[b]} is inside the merged range ${m.getA1Notation()}, below its top cell, so the write would be lost.`);
    });

  const rows = Object.keys(DATA.reasons);
  const mergedRows = blocks.reduce((n, b) => n + b.bot - b.top + 1, 0);
  if (DATA.cells.length !== DATA.counts.cells || Object.keys(DATA.e).length !== DATA.counts.e || rows.length !== DATA.counts.rows ||
      mergedRows !== DATA.counts.merged)
    problems.push(`Counts differ from the build: ${DATA.cells.length} cells, ${Object.keys(DATA.e).length} E, ${rows.length} rows, ` +
                  `${mergedRows} merged rows. Fetch the sheet again and rebuild.`);
  if (problems.length) throw new Error(`Nothing written:\n${problems.join('\n')}`);

  // 3. Log.
  DATA.cells.forEach(c => Logger.log(`R${rowOf[c.B]} ${c.col}  ${c.B}  ${c.mode}, ${c.text.length} chars: ${c.text.replace(/\s+/g, ' ').slice(0, 60)}`));
  blocks.forEach(({ m, top, bot }) => Logger.log(`${m.species}: merge D${top}:D${bot} (${bot - top + 1} rows, replaces ${m.filled.length} cells), ${m.text.length} chars`));
  Object.keys(DATA.e).forEach(b => Logger.log(`R${rowOf[b]} E  ${b}  ${DATA.e[b].split('\n').length} sources`));
  rows.forEach(b => DATA.reasons[b].forEach(g => Logger.log(`R${rowOf[b]} G  ${b}  + ${g}`)));
  Logger.log(`${DATA.cells.length} cells, ${blocks.length} merged ranges, ${Object.keys(DATA.e).length} E cells, ${rows.length} rows with reasons.`);
  if (SheetConfig.DRY_RUN) { Logger.log('DRY_RUN: nothing written. Set SheetConfig.DRY_RUN = false to apply.'); return; }

  // 4. Write.
  DATA.cells.forEach(c => {
    const r = rowOf[c.B];
    sheet.getRange(r, COL[c.col]).setValue(c.mode === 'append' ? `${raw(r, COL[c.col]).trimEnd()}
${c.text}` : c.text);
  });
  blocks.forEach(({ m, top, bot }) => {
    const range = sheet.getRange(top, COL.D, bot - top + 1, 1);
    range.setValues([[m.text]].concat(Array.from({ length: bot - top }, () => [''])));
    range.merge().setVerticalAlignment('top');
  });
  Object.keys(DATA.e).forEach(b => sheet.getRange(rowOf[b], COL.E).setValue(DATA.e[b]));
  rows.forEach(b => {
    const r = rowOf[b];
    if (SheetConfig.WRITE_REASONS) {
      let g = text(r, COL.G);
      DATA.reasons[b].forEach(x => { if (g.indexOf(x) < 0) g = g ? `${g}\n${x}` : x; });
      sheet.getRange(r, COL.G).setValue(g);
    }
    if (EDITOR) {
      const f = text(r, COL.F);
      if (f.indexOf(EDITOR) < 0) sheet.getRange(r, COL.F).setValue(f ? `${f}, ${EDITOR}` : EDITOR);
    }
  });
  SpreadsheetApp.flush();
  Logger.log(`Done: ${DATA.cells.length} cells, ${blocks.length} merged ranges, ${Object.keys(DATA.e).length} E cells, ${rows.length} rows with reasons.`);
}
